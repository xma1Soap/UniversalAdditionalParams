// YAML helpers (frontend-side, mirror of server util.js behavior)
// ---------------------------------------------------------------------------

/**
 * Parse a YAML-ish object string into a plain object.
 * Supports simple "key: value" lines plus JSON fallback.
 * (Full YAML is handled server-side by the `yaml` package; this is only for
 * preview/merge display and auto-rule merging into the exclude textarea.)
 */
function parseSimpleYamlObject(text) {
    if (!text || !String(text).trim()) return {};
    const raw = String(text).trim();
    // JSON fast path
    if (raw.startsWith('{')) {
        try {
            const obj = JSON.parse(raw);
            if (obj && typeof obj === 'object' && !Array.isArray(obj)) return obj;
        } catch { /* fall through to line parser */ }
    }
    const out = {};
    for (const line of raw.split('\n')) {
        const trimmed = line.trim();
        if (!trimmed || trimmed.startsWith('#')) continue;
        const idx = trimmed.indexOf(':');
        if (idx <= 0) continue;
        const key = trimmed.slice(0, idx).trim();
        let val = trimmed.slice(idx + 1).trim();
        if (!key) continue;
        if (val === '' || val === '~' || val.toLowerCase() === 'null') out[key] = null;
        else if (val === 'true') out[key] = true;
        else if (val === 'false') out[key] = false;
        else if (!isNaN(Number(val)) && val !== '') out[key] = Number(val);
        else out[key] = val.replace(/^['"]|['"]$/g, '');
    }
    return out;
}

function parseExcludeList(text) {
    if (!text || !String(text).trim()) return [];
    const raw = String(text).trim();
    // JSON array fast path
    if (raw.startsWith('[')) {
        try {
            const arr = JSON.parse(raw);
            if (Array.isArray(arr)) return arr.map(String);
        } catch { /* fall through */ }
    }
    const out = [];
    for (const line of raw.split('\n')) {
        const trimmed = line.trim().replace(/^-\s*/, '').replace(/^['"]|['"]$/g, '');
        if (!trimmed || trimmed.startsWith('#')) continue;
        // skip "key: value" mapping lines; exclude list is keys only
        if (trimmed.includes(':')) continue;
        out.push(trimmed);
    }
    return [...new Set(out)];
}

function serializeExcludeList(keys) {
    return keys.map(k => `- ${k}`).join('\n');
}
